# .gitignore

# ignore ruff cache
.cache/ruff

# ignore ruff logs
.cache/ruff/logs

# ignore ruff config
.cache/ruff/config

# ignore ruff results
.cache/ruff/results

# ignore other ruff files
.cache/ruff/*.pyc

# ignore other files
*.pyc
*.pyo
*.class
*.swp
*.log
*.tmp
*~

# ignore node modules
node_modules/

# ignore other venv files
venv/